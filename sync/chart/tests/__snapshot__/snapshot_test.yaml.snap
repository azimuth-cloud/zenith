templated manifests should match snapshot:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      annotations:
        nginx.ingress.kubernetes.io/backend-protocol: http
        nginx.ingress.kubernetes.io/proxy-body-size: "0"
        nginx.ingress.kubernetes.io/proxy-buffer-size: 16k
        nginx.ingress.kubernetes.io/proxy-buffering: "off"
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME
    spec:
      ingressClassName: nginx
      rules:
        - host: bar.foo.example.com
          http:
            paths:
              - backend:
                  service:
                    name: RELEASE-NAME
                    port:
                      name: dynamic
                path: /
                pathType: Prefix
      tls:
        - hosts:
            - bar.foo.example.com
          secretName: tls-RELEASE-NAME
  2: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME
    spec:
      ports:
        - name: dynamic
          port: 80
          protocol: TCP
          targetPort: dynamic
  3: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      annotations:
        traefik.ingress.kubernetes.io/service.serversscheme: http
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME-traefik
    spec:
      ingressClassName: traefik
      rules:
        - host: bar.foo.example.com
          http:
            paths:
              - backend:
                  service:
                    name: RELEASE-NAME
                    port:
                      name: dynamic
                path: /
                pathType: Prefix
      tls:
        - hosts:
            - bar.foo.example.com
          secretName: tls-RELEASE-NAME-traefik
templated manifests should match snapshot with external auth enabled:
  1: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      annotations:
        nginx.ingress.kubernetes.io/auth-signin: https://auth.example.com/login
        nginx.ingress.kubernetes.io/auth-signin-redirect-param: next
        nginx.ingress.kubernetes.io/auth-url: http://auth.example.com/verify
        nginx.ingress.kubernetes.io/backend-protocol: http
        nginx.ingress.kubernetes.io/proxy-body-size: "0"
        nginx.ingress.kubernetes.io/proxy-buffer-size: 16k
        nginx.ingress.kubernetes.io/proxy-buffering: "off"
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME
    spec:
      ingressClassName: nginx
      rules:
        - host: bar.foo.example.com
          http:
            paths:
              - backend:
                  service:
                    name: RELEASE-NAME
                    port:
                      name: dynamic
                path: /
                pathType: Prefix
      tls:
        - hosts:
            - bar.foo.example.com
          secretName: tls-RELEASE-NAME
  2: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME
    spec:
      ports:
        - name: dynamic
          port: 80
          protocol: TCP
          targetPort: dynamic
  3: |
    apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      annotations:
        traefik.ingress.kubernetes.io/router.middlewares: NAMESPACE-RELEASE-NAME-external-auth-errors@kubernetescrd,NAMESPACE-RELEASE-NAME-external-auth@kubernetescrd
        traefik.ingress.kubernetes.io/service.serversscheme: http
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME-traefik
    spec:
      ingressClassName: traefik
      rules:
        - host: bar.foo.example.com
          http:
            paths:
              - backend:
                  service:
                    name: RELEASE-NAME
                    port:
                      name: dynamic
                path: /
                pathType: Prefix
      tls:
        - hosts:
            - bar.foo.example.com
          secretName: tls-RELEASE-NAME-traefik
  4: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME-external-auth
    spec:
      forwardAuth:
        address: http://auth.example.com/verify
        trustForwardHeader: true
  5: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: main
        helm.sh/chart: zenith-service-0.1.0
        zenith.stackhpc.com/service-name: RELEASE-NAME
      name: RELEASE-NAME-external-auth-errors
    spec:
      errors:
        query: /?rd={url}
        service:
          name: zenith-signin-redirect
          port: http
        status:
          - 401-403
        statusRewrites:
          "401": 302
          "403": 302
